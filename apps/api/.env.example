# Banco de dados
# Porta do host onde o docker-compose expoe o MySQL (padrao 3306). Se a 3306
# ja estiver ocupada por outro MySQL na maquina, use outra (ex.: 3307) e
# ajuste a porta do DB_URL para o mesmo valor.
MYSQL_HOST_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/mecanica_sao_jorge
DB_USERNAME=mecanica
DB_PASSWORD=change-me-local

# JWT: gere um segredo forte com no minimo 32 bytes e NUNCA comite o valor real.
#   Ex.: openssl rand -base64 48
# O placeholder abaixo tem menos de 32 bytes DE PROPOSITO: se for copiado sem
# alterar, a aplicacao falha no boot (JwtConfig, ADR-004/ADR-009) em vez de
# subir com um segredo publico e conhecido.
JWT_SECRET=TROQUE-ESTE-VALOR
# 10080 minutos = 7 dias (ADR-004)
JWT_EXPIRATION_MINUTES=10080

# App
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
